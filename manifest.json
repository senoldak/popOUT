{
  "manifest_version": 3,
  "name": "popOUT - Smart Popup & Overlay Blocker",
  "version": "1.3.0",
  "description": "Intelligent popup & cookie banner blocker with site consent reset, heuristic engine, and live control dashboard.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "browsingData",
    "cookies",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "commands": {
    "reset-site-data": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Reset Stored Site Consents & Cookies for active tab"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["content/injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
